---
---
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>Gestión de Veterinaria Inteligente</h1>
      <p class="subtitle">Potencia la eficiencia de tu clínica con <strong>Patli</strong>, la solución integral diseñada para evolucionar tu práctica profesional. Desde la administración de tu equipo médico y el control total de clientes y pacientes, hasta un robusto sistema de punto de venta y gestión de residencia. Todo en una plataforma ágil, intuitiva y adaptable a cualquier tipo de veterinaria.</p>
      <div class="cta-group">
        <a href="#demo" class="btn btn-primary">Agenda una demo</a>
        <a href="#gratis" class="btn btn-secondary">Comienza gratis</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="desktop-frame">
        <div class="frame-top">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="ui-skeleton-bar" style="width: 120px; height: 8px; opacity: 0.1; background: #000;"></div>
        </div>
        <div class="app-ui-desktop">
          <aside class="ui-sidebar">
            <div class="ui-logo-placeholder"></div>
            <nav class="ui-sidebar-nav">
              <div class="ui-nav-item active"></div>
              <div class="ui-nav-item"></div>
              <div class="ui-nav-item"></div>
              <div class="ui-nav-item"></div>
              <div class="ui-nav-item"></div>
            </nav>
          </aside>
          <main class="ui-body">
            <header class="ui-header">
              <div class="ui-skeleton-bar" style="width: 150px; height: 12px; background: rgba(0,0,0,0.05);"></div>
              <div class="ui-profile">
                <div class="ui-skeleton-bar" style="width: 60px; height: 10px; background: rgba(0,0,0,0.1);"></div>
                <div class="ui-avatar"></div>
              </div>
            </header>
            <div class="ui-content">
              <div class="ui-cards">
                <div class="ui-card">
                  <div class="ui-skeleton-bar" style="width: 40%; height: 8px; background: var(--primary); opacity: 0.2;"></div>
                  <div class="ui-skeleton-bar" style="width: 70%; height: 14px; background: #000; opacity: 0.1;"></div>
                </div>
                <div class="ui-card">
                  <div class="ui-skeleton-bar" style="width: 40%; height: 8px; background: var(--primary); opacity: 0.2;"></div>
                  <div class="ui-skeleton-bar" style="width: 60%; height: 14px; background: #000; opacity: 0.1;"></div>
                </div>
                <div class="ui-card">
                  <div class="ui-skeleton-bar" style="width: 40%; height: 8px; background: var(--primary); opacity: 0.2;"></div>
                  <div class="ui-skeleton-bar" style="width: 80%; height: 14px; background: #000; opacity: 0.1;"></div>
                </div>
              </div>
              <div class="ui-list-abstract">
                <div class="ui-row-skeleton"><div class="dot"></div><div class="bar"></div><div class="bar-short"></div></div>
                <div class="ui-row-skeleton"><div class="dot"></div><div class="bar"></div><div class="bar-short"></div></div>
                <div class="ui-row-skeleton"><div class="dot"></div><div class="bar"></div><div class="bar-short"></div></div>
              </div>
            </div>
          </main>
        </div>
      </div>
      
      <div class="phone-frame">
        <div class="phone-speaker"></div>
        <div class="app-ui-mobile">
          <header class="mobile-ui-header">
            <div class="mobile-avatar"></div>
            <div class="ui-skeleton-bar" style="width: 80px; height: 12px; background: #000; opacity: 0.1;"></div>
          </header>
          <div class="mobile-ui-cards">
            <div class="m-card active">
              <div class="m-circle"></div>
              <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                <div class="ui-skeleton-bar" style="width: 60%; height: 10px; background: #000; opacity: 0.1;"></div>
                <div class="ui-skeleton-bar" style="width: 40%; height: 6px; background: #000; opacity: 0.05;"></div>
              </div>
            </div>
            <div class="m-card">
              <div class="m-circle" style="background: rgba(0,0,0,0.05);"></div>
              <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                <div class="ui-skeleton-bar" style="width: 50%; height: 10px; background: #000; opacity: 0.1;"></div>
                <div class="ui-skeleton-bar" style="width: 30%; height: 6px; background: #000; opacity: 0.05;"></div>
              </div>
            </div>
            <div class="m-card">
              <div class="m-circle" style="background: rgba(0,0,0,0.05);"></div>
              <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                <div class="ui-skeleton-bar" style="width: 70%; height: 10px; background: #000; opacity: 0.1;"></div>
                <div class="ui-skeleton-bar" style="width: 45%; height: 6px; background: #000; opacity: 0.05;"></div>
              </div>
            </div>
          </div>
          <nav class="mobile-ui-nav">
            <div class="nav-dot"></div>
            <div class="nav-dot active"></div>
            <div class="nav-dot"></div>
            <div class="nav-dot"></div>
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 6rem 2rem 8rem;
    background: radial-gradient(circle at top left, var(--accent) 0%, transparent 40%),
                radial-gradient(circle at bottom right, rgba(70, 177, 161, 0.1) 0%, transparent 40%);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: var(--paw-pattern);
    opacity: 0.3;
    pointer-events: none;
  }
  .container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hero-content h1 {
    font-size: 4.5rem; /* Aumentado de 3.5rem */
    line-height: 1.05;
    color: white;
    margin-bottom: 2rem;
    font-weight: 800;
    letter-spacing: -1px;
  }
  .subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: 1.8;
    text-align: left;
    max-width: 95%;
  }
  .subtitle strong {
    color: var(--primary);
  }
  .cta-group {
    display: flex;
    gap: 1rem;
  }
  .btn {
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background-color: var(--primary);
    color: white;
    box-shadow: 0 4px 14px 0 rgba(70, 177, 161, 0.39);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(70, 177, 161, 0.23);
  }
  .btn-secondary {
    background-color: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(5px);
  }
  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .hero-image {
    position: relative;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .desktop-frame {
    width: 600px;
    height: 400px;
    background: #ffffff;
    border-radius: 1.25rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    position: relative;
    z-index: 1;
    transform: perspective(1200px) rotateY(-12deg) rotateX(4deg);
    display: flex;
    flex-direction: column;
  }

  .frame-top {
    background: #f1f5f9;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .dots { display: flex; gap: 0.4rem; }
  .dots span { width: 8px; height: 8px; border-radius: 50%; background: #cbd5e1; }

  .app-ui-desktop {
    flex: 1;
    display: flex;
    background: #ffffff;
  }

  .ui-sidebar {
    width: 65px;
    background: #f8fafc;
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    border-right: 1px solid #e2e8f0;
  }

  .ui-logo-placeholder { 
    width: 32px; 
    height: 32px; 
    background: var(--primary); 
    border-radius: 10px; 
  }

  .ui-sidebar-nav { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; align-items: center; }
  .ui-nav-item { width: 24px; height: 24px; background: #e2e8f0; border-radius: 6px; }
  .ui-nav-item.active { background: var(--primary); }

  .ui-body { flex: 1; display: flex; flex-direction: column; }
  
  .ui-header {
    height: 60px;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
  }

  .ui-profile { display: flex; align-items: center; gap: 1rem; }
  .ui-avatar { width: 32px; height: 32px; background: #46B1A1; border-radius: 50%; }

  .ui-content { padding: 2rem; flex: 1; display: flex; flex-direction: column; gap: 2rem; }
  .ui-cards { display: flex; gap: 1.25rem; }
  .ui-card {
    flex: 1;
    background: #ffffff;
    padding: 1.25rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .ui-list-abstract { 
    background: #f8fafc; 
    border-radius: 16px; 
    padding: 1.25rem; 
    display: flex; 
    flex-direction: column; 
    gap: 1.25rem; 
    border: 1px solid #e2e8f0;
  }
  
  .ui-row-skeleton { display: flex; align-items: center; gap: 1rem; }
  .ui-row-skeleton .dot { width: 24px; height: 24px; background: #e2e8f0; border-radius: 6px; }
  .ui-row-skeleton .bar { flex: 1; height: 8px; background: #e2e8f0; border-radius: 4px; }
  .ui-row-skeleton .bar-short { width: 40px; height: 12px; background: rgba(70, 177, 161, 0.2); border-radius: 4px; }

  .phone-frame {
    position: absolute;
    width: 210px;
    height: 430px;
    background: #ffffff;
    border: 12px solid #334155;
    border-radius: 3rem;
    right: -40px;
    bottom: -10px;
    z-index: 2;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.9);
    overflow: hidden;
    transform: perspective(1200px) rotateY(12deg);
  }

  .app-ui-mobile { height: 100%; padding: 2.5rem 1.5rem; display: flex; flex-direction: column; gap: 2rem; background: #ffffff; }
  .mobile-ui-header { display: flex; align-items: center; gap: 1rem; }
  .mobile-avatar { width: 42px; height: 42px; background: #46B1A1; border-radius: 50%; }
  
  .mobile-ui-cards { display: flex; flex-direction: column; gap: 1.25rem; }
  .m-card {
    background: #ffffff;
    padding: 1.25rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  .m-card.active { border-color: var(--primary); background: rgba(70, 177, 161, 0.05); }
  .m-circle { width: 32px; height: 32px; background: var(--primary); border-radius: 10px; }

  .mobile-ui-nav {
    margin-top: auto;
    background: #f8fafc;
    height: 55px;
    border-radius: 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border: 1px solid #e2e8f0;
  }
  .nav-dot { width: 10px; height: 10px; background: #e2e8f0; border-radius: 50%; }
  .nav-dot.active { background: var(--primary); }

  .ui-skeleton-bar { border-radius: 4px; }

  @media (max-width: 768px) {
    .hero-image { height: 400px; transform: scale(0.8); }
    .desktop-frame { width: 100%; transform: none; }
    .phone-frame { display: none; }
    .container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .cta-group {
      justify-content: center;
    }
    .hero-content h1 {
      font-size: 2.5rem;
    }
  }
</style>
