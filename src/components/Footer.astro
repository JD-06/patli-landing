---
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h2>Patli</h2>
        <p>Gestión clínica inteligente para veterinarios.</p>
      </div>
      <div class="footer-links">
        <h3>Recursos</h3>
        <ul>
          <li><a href="#features">Características</a></li>
          <li><a href="#pricing">Planes</a></li>
          <li><a href="javascript:void(0)" id="support-trigger">Soporte</a></li>
        </ul>
      </div>
      <div class="footer-legal">
        <h3>Legal</h3>
        <ul>
          <li><a href="/privacidad">Privacidad</a></li>
          <li><a href="/terminos">Términos</a></li>
        </ul>
      </div>
      <div class="footer-contact">
        <h3>Síguenos</h3>
        <div class="social-links">
          <a href="#" class="social-icon" title="Facebook">FB</a>
          <a href="#" class="social-icon" title="Instagram">IG</a>
          <a href="#" class="social-icon" title="WhatsApp">WA</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Patli. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<!-- Modal de Soporte -->
<div id="support-modal" class="modal-overlay">
  <div class="modal-content">
    <button class="close-modal" id="close-modal">&times;</button>
    <h2>Soporte Patli</h2>
    <p>Estamos listos para ayudarte. Elige tu canal preferido:</p>
    
    <div class="support-options">
      <a href="https://wa.me/1234567890" target="_blank" class="support-btn whatsapp">
        <span class="btn-icon">WA</span>
        <div class="btn-text">
          <strong>WhatsApp</strong>
          <span>Respuesta inmediata</span>
        </div>
      </a>
      
      <a href="tel:+1234567890" class="support-btn phone">
        <span class="btn-icon">📞</span>
        <div class="btn-text">
          <strong>Llamada</strong>
          <span>Lunes a Viernes, 9am - 6pm</span>
        </div>
      </a>
      
      <a href="mailto:info@patli.app" class="support-btn email">
        <span class="btn-icon">✉️</span>
        <div class="btn-text">
          <strong>Correo</strong>
          <span>info@patli.app</span>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('support-trigger');
  const modal = document.getElementById('support-modal');
  const closeBtn = document.getElementById('close-modal');

  if (trigger && modal && closeBtn) {
    trigger.addEventListener('click', () => {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  }
</script>

<style>
  .footer {
    padding: 4rem 2rem 2rem;
    background-color: var(--bg);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }
  .footer-brand h2 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .footer-brand p {
    color: var(--text-muted);
    max-width: 300px;
  }
  .footer-grid h3 {
    font-size: 1.125rem;
    color: white;
    margin-bottom: 1.5rem;
  }
  .footer-grid ul {
    list-style: none;
    padding: 0;
  }
  .footer-grid ul li {
    margin-bottom: 0.75rem;
  }
  .footer-grid a {
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s;
  }
  .footer-grid a:hover {
    color: var(--primary);
  }
  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-icon {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted) !important;
    font-size: 0.75rem;
    font-weight: bold;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .social-icon:hover {
    background: var(--primary);
    color: white !important;
    border-color: var(--primary);
    transform: translateY(-3px);
  }
  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  /* Estilos del Modal */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    display: none; /* Cambiado de opacity 0 */
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .modal-overlay.active {
    display: flex; /* Mostrar solo cuando esté activo */
  }

  .modal-content {
    background: white;
    width: 90%;
    max-width: 450px;
    padding: 3rem 2rem;
    border-radius: 2rem;
    position: relative;
    transform: translateY(20px);
    transition: all 0.3s ease;
    text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0);
  }

  .close-modal {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    font-size: 2rem;
    color: #94a3b8;
    cursor: pointer;
    line-height: 1;
  }

  .modal-content h2 {
    color: #0f172a;
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .modal-content p {
    color: #64748b;
    margin-bottom: 2rem;
  }

  .support-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .support-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    text-decoration: none;
    text-align: left;
    transition: all 0.2s ease;
    border: 1px solid #f1f5f9;
    background: #f8fafc;
  }

  .support-btn:hover {
    transform: scale(1.02);
    border-color: var(--primary);
    background: #ffffff;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  .btn-icon {
    width: 45px;
    height: 45px;
    background: var(--primary);
    color: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .whatsapp .btn-icon { background: #22c55e; }
  .phone .btn-icon { background: var(--secondary); }
  .email .btn-icon { background: var(--primary); }

  .btn-text strong {
    display: block;
    color: #0f172a;
    font-size: 1rem;
  }

  .btn-text span {
    color: #64748b;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
